        "#@title 5. TensorFlow 데이터셋 생성\n",
        "def make_ds(imgs, lbls, train=True, batch_size=BATCH_SIZE):\n",
        "    ds = tf.data.Dataset.from_tensor_slices(([str(p) for p in imgs], [str(p) for p in lbls]))\n",
