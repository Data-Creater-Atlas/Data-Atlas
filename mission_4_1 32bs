        "        ds = ds.shuffle(len(imgs), seed=SEED, reshuffle_each_iteration=True)\n",
        "    ds = ds.map(load_pair, num_parallel_calls=AUTOTUNE)\n",
        "    if train:\n",
        "        ds = ds.map(strong_aug, num_parallel_calls=AUTOTUNE)\n",
        "    ds = ds.batch(batch_size).prefetch(AUTOTUNE)\n",
        "    return ds\n",
